{
  "name": "scrolling-based-progressbar",
  "version": "2.0.0",
  "description": "React progress bar that updates as the page is scrolled. Supports React 16.8 through 19.",
  "author": "ValeedAnjum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ValeedAnjum/scrolling-based-progressbar.git"
  },
  "homepage": "https://github.com/ValeedAnjum/scrolling-based-progressbar#readme",
  "bugs": {
    "url": "https://github.com/ValeedAnjum/scrolling-based-progressbar/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "progress-bar",
    "scroll-progress",
    "react-progress-bar",
    "scrolling-progress-bar",
    "react",
    "scroll"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build --watch",
    "prepare": "npm run build",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/dist"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
